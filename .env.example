# Production overrides only; local Development generates a key outside the repository.
Jwt__SigningKey=
POSTGRES_PASSWORD=
ConnectionStrings__Default=

# Optional overrides for SMTP. Local development uses Mailpit on localhost:1025.
Email__Host=localhost
Email__Port=1025
Email__EnableSsl=false
Email__From=no-reply@cynthia.local

# Optional override when the front-end is hosted elsewhere.
Frontend__BaseUrl=http://localhost:4200
Cors__AllowedOrigins__0=http://localhost:4200
Support__Email=ccynthiaapps@gmail.com

# Optional Supabase S3-compatible image storage; keep credentials server-side.
SupabaseStorage__Endpoint=https://<project-ref>.supabase.co/storage/v1/s3
SupabaseStorage__Bucket=Cynthia
SupabaseStorage__Region=
SupabaseStorage__AccessKey=
SupabaseStorage__SecretKey=
